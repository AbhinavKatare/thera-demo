# ---- apps/api ------------------------------------------------------------
DATABASE_URL=postgresql://paypilot:paypilot@localhost:5432/paypilot?schema=public
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# ---- apps/slack (Bolt / Socket Mode) --------------------------------------
# Socket Mode needs an App-Level token for WS connections + a bot token.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret
API_BASE_URL=http://localhost:4000

# ---- adapters (all have mock_* impls for local dev) -----------------------
# connectors: quickbooks | xero | mock
ACCOUNTING_CONNECTOR=mock
# ai: anthropic | openai | mock
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- apps/web -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
